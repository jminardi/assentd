{
  "manifest_version": 3,
  "name": "assentd fill",
  "version": "0.1.0",
  "description": "Fills a password from assentd into the current tab after you approve it with Face ID.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["nativeMessaging", "scripting", "tabs", "alarms"],
  "host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_icon": { "32": "icon-32.png" } },
  "icons": { "32": "icon-32.png", "128": "icon-128.png" }
}
